# ClickHouse connection (inside the Docker network)
CH_HOST=clickhouse
CH_PORT=8123
CH_DB=sensors
CH_USER=
CH_PASSWORD=

# ClickHouse storage (named volume by default; set to a path for a bind-mount)
CH_DATA_DIR=/data1/pouya_data/clickhouse

# Optional: host ports published for ClickHouse (localhost-only by default in docker-compose.yml)
CH_HTTP_PUBLISHED_PORT=8123
CH_TCP_PUBLISHED_PORT=9000

# Optional: pin ClickHouse image/tag for reproducible deploys
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:latest

# Scheduler timezone
JOB_TZ=America/Chicago

# Host port for the Dash web UI
APP_PORT=8000
